{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "皮影古件演出保全与演出负荷护照领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "OBJECT_INSPECTED",
        "PERFORMANCE_PLANNED",
        "SUBSTITUTE_ASSIGNED",
        "REPAIR_RECORDED",
        "CLEARANCE_GRANTED",
        "BOOKING_REQUESTED",
        "BOOKING_DECIDED",
        "BOOKING_RESCHEDULED",
        "BOOKING_SUSPENDED",
        "BOOKING_CANCELLED",
        "BOOKING_RECONFIRM_REQUIRED",
        "STANDBY_ASSIGNED",
        "USAGE_RECORDED",
        "INCIDENT_REPORTED",
        "INCIDENT_RESOLVED",
        "REPAIR_PROPOSED",
        "REPAIR_SIGNED",
        "REPAIR_COMPLETED",
        "NOTIFICATION_REQUESTED",
        "NOTIFICATION_DELIVERED",
        "REVIEW_OPENED",
        "REVIEW_RESOLVED"
      ],
      "description": "前五项为既有古件检查/排程/替身/修复/许可约定；其余为演出负荷护照事件。"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "puppet_object",
        "performance_plan",
        "conservation_action",
        "operator_clearance",
        "booking",
        "incident",
        "substitute",
        "notification",
        "review"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "按 aggregate_type/aggregate_id 独立递增；同一批次对多个聚合的更新各自取号。"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "client_message_id": {
      "type": "string",
      "description": "离线客户端消息编号。同编号重传内容一致时不产生新事件、不重复扣减；内容变化进入保全复核。"
    },
    "content_hash": {
      "type": "string",
      "description": "消息内容的 SHA-256，用于重传一致性比对。"
    }
  },
  "additionalProperties": true
}
